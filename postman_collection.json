{
  "info": {
    "name": "SmartList API",
    "description": "Coleção pronta para testar os endpoints da SmartList API (Projeto Integrador).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "usuarioId", "value": "1" },
    { "key": "categoriaId", "value": "1" },
    { "key": "listaId", "value": "1" }
  ],
  "item": [
    {
      "name": "POST /api/usuarios - Cadastrar usuario",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Maria Teste\",\n  \"email\": \"maria@teste.com\",\n  \"senha\": \"senha123\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/usuarios", "host": ["{{baseUrl}}"], "path": ["api", "usuarios"] }
      }
    },
    {
      "name": "GET /api/usuarios/:id - Buscar usuario por id",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/usuarios/{{usuarioId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "usuarios", "{{usuarioId}}"]
        }
      }
    },
    {
      "name": "POST /api/categorias - Cadastrar categoria",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Bebidas\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/categorias", "host": ["{{baseUrl}}"], "path": ["api", "categorias"] }
      }
    },
    {
      "name": "GET /api/categorias - Listar categorias",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/categorias", "host": ["{{baseUrl}}"], "path": ["api", "categorias"] }
      }
    },
    {
      "name": "POST /api/listas - Cadastrar lista",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Compras do mes\",\n  \"usuarioId\": {{usuarioId}},\n  \"linkReferencia\": \"https://exemplo.com/receita\",\n  \"categoriaIds\": [{{categoriaId}}]\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/listas", "host": ["{{baseUrl}}"], "path": ["api", "listas"] }
      }
    },
    {
      "name": "GET /api/listas - Listar listas",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/listas", "host": ["{{baseUrl}}"], "path": ["api", "listas"] }
      }
    },
    {
      "name": "GET /api/listas - Filtrar por categoria + paginacao",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/listas?categoria=Bebidas&page=1&pageSize=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "listas"],
          "query": [
            { "key": "categoria", "value": "Bebidas" },
            { "key": "page", "value": "1" },
            { "key": "pageSize", "value": "10" }
          ]
        }
      }
    },
    {
      "name": "POST /api/listas/:id/avaliacoes - Avaliar lista",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nota\": 5,\n  \"comentario\": \"Lista muito completa!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/listas/{{listaId}}/avaliacoes",
          "host": ["{{baseUrl}}"],
          "path": ["api", "listas", "{{listaId}}", "avaliacoes"]
        }
      }
    },
    {
      "name": "PUT /api/listas/:id/favoritar - Favoritar (upvote)",
      "request": {
        "method": "PUT",
        "url": {
          "raw": "{{baseUrl}}/api/listas/{{listaId}}/favoritar",
          "host": ["{{baseUrl}}"],
          "path": ["api", "listas", "{{listaId}}", "favoritar"]
        }
      }
    },
    {
      "name": "[ERRO 404] GET /api/usuarios/999999 - usuario inexistente",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/usuarios/999999",
          "host": ["{{baseUrl}}"],
          "path": ["api", "usuarios", "999999"]
        }
      }
    },
    {
      "name": "[ERRO 400] POST /api/listas/:id/avaliacoes - nota invalida (fora de 1-5)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nota\": 9\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/listas/{{listaId}}/avaliacoes",
          "host": ["{{baseUrl}}"],
          "path": ["api", "listas", "{{listaId}}", "avaliacoes"]
        }
      }
    }
  ]
}
